generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PLANNING
  VIEWER
  PENDING
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role     @default(VIEWER)
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Site {
  id        String   @id @default(cuid())
  name      String
  address   String?
  active    Boolean  @default(true)
  // Khung tên bản vẽ in ra lấy từ đây, thay vì bắt gõ lại mỗi lần xuất PDF
  companyName String? @map("company_name")
  companyLogo String? @map("company_logo") // URL ảnh logo đã tải lên
  createdAt DateTime @default(now()) @map("created_at")
  layouts   Layout[]

  @@map("sites")
}

model Asset {
  id          String    @id @default(cuid())
  fileName    String    @map("file_name")
  fileType    String    @map("file_type") // dwg | dxf | step | stp | ifc
  status      String    @default("pending") // pending | processing | ready | failed
  error       String?
  unitScale   Float     @default(0.001) @map("unit_scale") // file unit -> meters
  bboxLengthM Float?    @map("bbox_length_m")
  bboxWidthM  Float?    @map("bbox_width_m")
  bboxHeightM Float?    @map("bbox_height_m")
  areaM2      Float?    @map("area_m2") // footprint area
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("assets")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("projects")
}

model Layout {
  id             String     @id @default(cuid())
  siteId         String     @map("site_id")
  name           String
  widthM         Float      @map("width_m")
  heightM        Float      @map("height_m")
  backgroundFile String?    @map("background_file")
  gridSize       Float      @default(1.0) @map("grid_size")
  // Ranh giới/tường của mặt bằng (mét). Hình học cố định của layout, không đổi
  // theo ngày như vị trí block nên không nằm trong snapshot.
  walls          Json?
  // Block trong file DXF nền ứng với sản phẩm nào: { "<tên block>": "<productId>" }.
  // Thuộc về nội dung bản vẽ chứ không phải sở thích cá nhân, nên để ở server
  // cho cả nhóm dùng chung thay vì mỗi máy map lại từ đầu.
  dxfBlockMap    Json?      @map("dxf_block_map")
  // Căn ảnh nền với bản vẽ: { offsetXCm, offsetYCm, scale, rotationDeg, opacity }.
  // Nền dựng từ DXF thì khớp sẵn, nhưng ảnh scan/chụp không mang tỉ lệ nên phải
  // canh tay. Để ở server cho cả nhóm dùng chung, giống dxfBlockMap.
  bgTransform    Json?      @map("bg_transform")
  createdAt      DateTime   @default(now()) @map("created_at")
  site           Site       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  snapshots      Snapshot[]
  plans      Plan[]
  comments   Comment[]
  locks      LayoutLock[]

  @@map("layouts")
}

model Product {
  id             String     @id @default(cuid())
  projectId      String     @map("project_id")
  name           String
  code           String
  weightKg       Float?     @map("weight_kg")
  areaM2         Float?     @map("area_m2")
  processStage   String?    @map("process_stage")
  category       String     @default("san_pham")
  color          String     @default("#58a6ff")
  file2dUrl      String?    @map("file_2d_url")
  file3dUrl      String?    @map("file_3d_url")
  thumbnail      String?
  sharepointLink String?    @map("sharepoint_link")
  metadata       Json?
  quantity       Int        @default(1)
  assetId        String?    @map("asset_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset          Asset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  positions      Position[]
  planItems  PlanItem[]

  /// Mã sản phẩm là duy nhất trong một dự án. Đây là khoá để việc nhập
  /// hàng loạt biết một file CAD đã được nhập hay chưa, và để hai request
  /// cùng mã chạy song song không cùng tạo ra sản phẩm.
  @@unique([projectId, code])
  @@map("products")
}

model Snapshot {
  id        String     @id @default(cuid())
  layoutId  String     @map("layout_id")
  date      DateTime   @db.Date
  note      String?
  createdAt DateTime   @default(now()) @map("created_at")
  createdBy String?    @map("created_by")
  version   Int        @default(1)
  // Ảnh xem trước mặt bằng (chụp từ canvas editor khi autosave)
  thumbnail String?
  layout    Layout     @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  positions Position[]
  comments  Comment[]

  @@unique([layoutId, date])
  @@map("snapshots")
}

model Position {
  id          String   @id @default(cuid())
  snapshotId  String   @map("snapshot_id")
  productId   String   @map("product_id")
  x           Float
  y           Float
  rotation    Float    @default(0)
  scale       Float    @default(1.0)
  orientation String   @default("bottom") // bottom | side | end - mat tiep san cua block
  // Cao do dat block so voi san, tinh bang met (0 = dat truc tiep xuong san)
  elevationM  Float    @default(0) @map("elevation_m")
  // Email nguoi cuoi cung dat/di chuyen block nay. Server tu suy ra bang cach
  // so sanh voi ban luu truoc, khong tin gia tri client gui len.
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @default(now()) @map("updated_at")
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("positions")
}

model Plan {
  id        String     @id @default(cuid())
  layoutId  String     @map("layout_id")
  name      String
  active    Boolean    @default(true)
  version   Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at")
  layout    Layout     @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  items     PlanItem[]

  @@map("plans")
}

model PlanItem {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  productId String   @map("product_id")
  x         Float
  y         Float
  rotation  Float    @default(0)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("plan_items")
}

/**
 * Khoa mem cho mot (layout, ngay): bao cho nguoi vao sau biet ai dang sua.
 * Khong chan xem, khong chan chinh sua tai cho — chi chan LUU.
 * Co han (expiresAt) + heartbeat de khong bi ket khoa khi ai do dong tab.
 */
model LayoutLock {
  id        String   @id @default(cuid())
  layoutId  String   @map("layout_id")
  date      DateTime @db.Date
  userId    String   @map("user_id")
  userEmail String   @map("user_email")
  userName  String   @map("user_name")
  acquiredAt DateTime @default(now()) @map("acquired_at")
  expiresAt DateTime @map("expires_at")
  layout    Layout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, date])
  @@map("layout_locks")
}

model Comment {
  id         String    @id @default(cuid())
  layoutId   String    @map("layout_id")
  snapshotId String?   @map("snapshot_id")
  positionX  Float?    @map("position_x")
  positionY  Float?    @map("position_y")
  text       String
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  layout   Layout    @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  snapshot Snapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("comments")
  @@index([layoutId])
  @@index([snapshotId])
}

/// Công đoạn sản xuất dùng chung toàn hệ thống (gá, hàn, sơn…). Màu để tô block
/// theo công đoạn đang làm. Xoá là soft-delete (active=false) để giữ lịch sử.
model Stage {
  id        String   @id @default(cuid())
  name      String
  color     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stages")
}

/// Cấu hình toàn hệ thống dạng key-value. Hiện dùng cho key "outsideZonePolicy"
/// ('block' | 'warn' | 'silent') — cách xử lý sản phẩm đặt ngoài mọi vùng.
model AppSetting {
  key   String @id
  value Json

  @@map("app_settings")
}
