{
  "name": "floor-manager",
  "version": "1.0.0",
  "type": "module",
  "description": "Floor Manager backend - Express + Prisma + PostgreSQL",
  "license": "ISC",
  "scripts": {
    "server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "test": "npm run test:migrate && cross-env DATABASE_URL=postgresql://floormanager:floormanager123@localhost:5432/floormanager_test vitest run",
    "test:migrate": "cross-env DATABASE_URL=postgresql://floormanager:floormanager123@localhost:5432/floormanager_test prisma migrate deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
